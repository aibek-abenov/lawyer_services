<!-- app/views/devise/sessions/new.html.erb -->
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="bg-white shadow-xl rounded-2xl p-8 w-full max-w-md">
    <h2 class="text-2xl font-semibold text-gray-800 text-center mb-6">
      Вход в систему
    </h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>
      </div>

      <div>
        <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password,
                             autocomplete: "current-password",
                             class: "w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <%= f.label :remember_me, "Запомнить меня", class: "ml-2 text-sm text-gray-700" %>
        </div>
      <% end %>

      <div class="pt-4">
        <%= f.submit "Войти",
                     class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm text-gray-600 space-y-2">
      <% if devise_mapping.recoverable? %>
        <div>
          <%= link_to "Забыли пароль?", new_password_path(resource_name),
                      class: "text-blue-600 hover:text-blue-700 font-medium" %>
        </div>
      <% end %>

      <% if devise_mapping.registerable? %>
        <div>
          <%= link_to "Создать аккаунт", new_registration_path(resource_name),
                      class: "text-blue-600 hover:text-blue-700 font-medium" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
